const SPRITE_TILES: [u8; 16] = [
    // Paddle
    0xFF,0x7E,
    0x81,0x81,
    0xFF,0x7E,
    0x00,0x00,
    0x00,0x00,
    0x00,0x00,
    0x00,0x00,
    0x00,0x00,
];

// Sprite indexes

const PADDLE_INDEX: u16 = 0;

// Globals

// In gb-asm-tutorial, these are stored in half the number of
// bytes as they store the d-pad in the high nibble. Unfortunately
// Quokka doesn't support syntax for SWAP so to work around this
// we just store it in double the amount of bytes
global CURRENT_BUTTONS: u8;
global CURRENT_D_PAD: u8;
global NEW_BUTTONS: u8;
global NEW_D_PAD: u8;

//
// Code
//

fn main() {
    // disable LCD during next vblank
    wait_for_vblank();
    // Disable LCD as copying to VRAM will take more than vblank
    rLCDC = LCDC_OFF;

    // Now that the LCD is off, we can take longer than vblank to
    // setup VRAM how we need it
    VRAM_BG_TILES = BG_TILES;
    VRAM_BG_TILEMAP = BG_TILEMAP;
    VRAM_SPRITE_TILES = SPRITE_TILES;

    clear_oam();

    // set up paddle's initial state
    OAM[PADDLE_INDEX].y = 128 + 16;
    OAM[PADDLE_INDEX].x = 16 + 8;
    OAM[PADDLE_INDEX].tile_index = 0;
    OAM[PADDLE_INDEX].flags = 0;

    // Turn on LCD and setup the palette
    rLCDC = LCDC_ON | LCDC_BG_ON | LCDC_OBJ_ON;
    rBGP = BG_PALETTE;

    loop {
        // wait for when we are rendering
        wait_for_not_vblank();

        // We don't actually anything to do during rendering atm.
        // This will change in the future as rendering is a good time
        // to do game logic and update a shadow OAM

        // wait until its safe to modify VRAM/OAM
        wait_for_vblank();

        update_keys();

        if CURRENT_D_PAD & PAD_LEFT != 0 then {
            let x = OAM[PADDLE_INDEX].x - 1;
            if x != 15 then {
                OAM[PADDLE_INDEX].x = x;
            }
        } else if CURRENT_D_PAD & PAD_RIGHT != 0 then {
            let x = OAM[PADDLE_INDEX].x + 1;
            if x != 105 then {
                OAM[PADDLE_INDEX].x = x;
            }
        }
    }
}

fn wait_for_vblank() {
    loop {
        if rLY >= LY_VBLANK then {
            break;
        }
    }
}

fn wait_for_not_vblank() {
    loop {
        if rLY < LY_VBLANK then {
            break;
        }
    }
}

fn clear_oam() {
    // ideally, we would do the following:
    // ```
    //      OAM = [Sprite { y: 0, x: 0, tile_index: 0, flags: 0, }; 40];
    // ```
    // Unfortunately, bulk-fill only supports raw bytes currently, not arbitrary constants.
    // We could model OAM as a byte array and use that, but instead, it is more typesafe to
    // model it with structs and just accept that clearing OAM (which only is used at startup)
    // takes a little bit longer
    let index = 0;
    loop {
        if index >= 40 then {
            break;
        }

        OAM[index].y = 0;
        OAM[index].x = 0;
        OAM[index].tile_index = 0;
        OAM[index].flags = 0;

        index += 1;
    }
}

fn update_keys() {
    rJOYP = JOYP_GET_BUTTONS;
    waste_16_m_cycles();
    let current_buttons = (rJOYP | 0xF0) ^ 0xFF;

    rJOYP = JOYP_GET_CTRL_PAD;
    waste_16_m_cycles();
    let current_d_pad = (rJOYP | 0xF0) ^ 0xFF;

    //NEW_BUTTONS = (CURRENT_BUTTONS ^ current_buttons) & current_buttons;
    CURRENT_BUTTONS = current_buttons;

    //NEW_D_PAD = (CURRENT_D_PAD ^ current_d_pad) & current_d_pad;
    CURRENT_D_PAD = current_d_pad;
}

// technically this is 18 cycles currently as we don't optimize high loads
// so it will use `LD A, [n16]` instead of `LDH a, [n8]`. However this should
// still work the same for now
fn waste_16_m_cycles() {
    let a = rJOYP;
    let a = rJOYP;
}