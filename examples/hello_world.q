const BG_PALETTE: u8 = 0b1110_0100;

fn main() {
    // Disable audio
    rAUDENA = AUDIO_OFF;
    // wait for vblank as you cannot disable the LCDC during vblank
    loop {
        if rLY >= LY_VBLANK then {
            break;
        }
    }
    // Disable LCD as copying to VRAM will take more than vblank
    rLCDC = LCDC_OFF;

    // copy the tiles to vram
    let i = 0;
    loop {
        BG_TILES[i] = TILES[i];
        i += 1;
        if i >= 1120 then {
            break;
        }
    }

    // copy the tilemap to vram
    let i = 0;
    loop {
        BG_TILEMAP[i] = TILEMAP[i];
        i += 1;
        if i >= 576 then {
            break;
        }
    }

    // enable LCD with BG on
    rLCDC = LCDC_ON | LCDC_BG_ON;
    // This is safe to do immediately after enabling the LCD as we'll still be in vblank
    rBGP = BG_PALETTE;
}