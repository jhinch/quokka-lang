//
// IO Registers
//

#[address = 0xFF00]
global rJOYP: u8;
const JOYP_GET_BUTTONS: u8 = 0x00_01_0000;
const JOYP_GET_CTRL_PAD: u8 = 0x00_10_0000;
// Currently these are not shifted to the high nibble similar to hardware.inc as Quokka doesn't have SWAP support
const PAD_LEFT: u8 = 0b0000_0010;
const PAD_RIGHT: u8 = 0b0000_0001;

#[address = 0xFF44]
global rLY: u8;
const LY_VBLANK: u8 = 144;

#[address = 0xFF40]
global rLCDC: u8;
const LCDC_OFF: u8 = 0b0000_0000;
const LCDC_ON: u8 = 0b1000_0000;
const LCDC_BG_ON: u8 = 0b0000_0001;
const LCDC_OBJ_ON: u8 = 0b0000_0010;


#[address = 0xFF47]
global rBGP: u8;

//
// VRAM and OAM
//

#[region = vram]
#[address = 0x8000]
global VRAM_SPRITE_TILES: [u8; 16];

#[region = vram]
#[address = 0x9000]
global VRAM_BG_TILES: [u8; 416];
#[region = vram]
#[address = 0x9800]
global VRAM_BG_TILEMAP: [u8; 576];

#[region = oam]
global OAM: [Sprite; 40];

struct Sprite {
    y: u8,
    x: u8,
    tile_index: u8,
    flags: u8,
}

